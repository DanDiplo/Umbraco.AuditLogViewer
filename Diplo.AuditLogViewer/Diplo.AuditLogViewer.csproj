<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Product>Diplo.AuditLogViewer</Product>
    <PackageId>Diplo.AuditLogViewer</PackageId>
    <Title>Diplo Audit Log Viewer</Title>
    <Description>Umbraco 17 backoffice viewer for umbracoLog and umbracoAudit data, with filtering, sorting, paging, contextual entity links, detail drawers, and optional CSV export.</Description>
    <PackageTags>umbraco plugin package audit log viewer umbraco-marketplace</PackageTags>
    <VersionPrefix>17.0.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <Company>$(Authors)</Company>
    <Copyright>Dan 'Diplo' Booth</Copyright>
    <Authors>DanDiplo</Authors>
    <PackageProjectUrl>https://github.com/DanDiplo/Diplo.AuditLogViewer</PackageProjectUrl>
    <PackageIcon>DiploAuditLogViewerIcon.png</PackageIcon>
    <PackageReadmeFile>NuGet.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/DanDiplo/Diplo.AuditLogViewer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Umbraco 17 / .NET 10 rewrite. Backoffice rebuilt with Lit + TypeScript, Management API endpoints, contextual entity links, node autocomplete, date presets, detail drawers, and optional CSV export.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <CompressionEnabled>false</CompressionEnabled>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Core" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="App_Plugins\**" />
    <Compile Remove="Client\**" />
    <Content Remove="App_Plugins\**" />
    <Content Remove="Client\**" />
    <None Remove="App_Plugins\**" />
    <None Remove="Client\**" />
    <EmbeddedResource Remove="App_Plugins\**" />
    <EmbeddedResource Remove="Client\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="Client\vite.config.ts" Pack="false" />
    <None Include="Client\tsconfig.json" Pack="false" />
    <None Include="Client\package.json" Pack="false" />
    <None Include="Client\src\**\*" Pack="false" />
    <None Include="..\Images\Icon\DiploAuditLogViewerIcon.png" Pack="true" PackagePath="\" />
    <None Update="NuGet.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="RestoreClientPackages" BeforeTargets="BuildClient" Condition="!Exists('$(MSBuildProjectDirectory)\Client\node_modules')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
  </Target>

  <Target Name="BuildClient" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
  </Target>

  <Target Name="BuildClientForPack" BeforeTargets="Pack">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
  </Target>

</Project>

